rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid) && request.resource.data.role == 'student';
      allow update: if admin() || (self(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountStatus == resource.data.accountStatus);
      allow delete: if admin();
    }
    match /academicProfiles/{uid} {
      allow read, create, update: if self(uid) || admin();
      allow delete: if admin();
    }
    match /userPreferences/{uid} {
      allow read, create, update, delete: if self(uid);
    }
    match /results/{resultId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.credits > 0
        && request.resource.data.points >= 0
        && request.resource.data.qualityPoints == request.resource.data.credits * request.resource.data.points;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || admin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.credits > 0
        && request.resource.data.points >= 0
        && request.resource.data.qualityPoints == request.resource.data.credits * request.resource.data.points;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
    }
    match /notifications/{notificationId} {
      allow read, update, delete: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if admin();
    }
    match /supportTickets/{ticketId} {
      allow read, update: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if admin();
    }
    match /publicSupportRequests/{id} { allow create: if true; allow read, update, delete: if admin(); }
    match /reports/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if admin(); }
    match /transactions/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow write: if admin(); }
    match /subscriptions/{uid} { allow read: if self(uid) || admin(); allow write: if admin(); }
    match /dataExportRequests/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow update, delete: if admin(); }
    match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
    match /adminSettings/{id} { allow read, write: if admin(); }
    match /notificationCampaigns/{id} { allow read, write: if admin(); }

    match /faculties/{id} { allow read: if true; allow write: if admin(); }
    match /departments/{id} { allow read: if true; allow write: if admin(); }
    match /programmes/{id} { allow read: if true; allow write: if admin(); }
    match /academicVersions/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /levels/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /semesters/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /academicSessions/{id} { allow read: if true; allow write: if admin(); }
    match /gradingRules/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /courses/{id} { allow read: if signedIn(); allow write: if admin(); }
  }
}
