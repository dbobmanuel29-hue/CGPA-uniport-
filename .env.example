# Firebase client configuration (public web-app settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check reCAPTCHA v3 site key. Required for anonymous public support submissions.
# Create/register the web app in Firebase App Check and add this public site key.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Cloudinary unsigned upload configuration (no API secret belongs here)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional Google Analytics 4 measurement ID. Analytics is loaded only after consent.
VITE_GA_MEASUREMENT_ID=
